{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "cloudflare.config.ts", "vite.config.ts", "vite/**/*.ts", "vitest.config.ts", ".cloudflare/types/index.d.ts"],
  // The board UI runs in the browser (DOM lib): checked by tsconfig.ui.json.
  "exclude": ["src/task-board-ui/**"]
}
