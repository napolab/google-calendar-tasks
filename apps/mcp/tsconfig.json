{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "cloudflare.config.ts", "vite.config.ts", "vitest.config.ts", ".cloudflare/types/index.d.ts"]
}
