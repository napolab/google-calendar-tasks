{
  "name": "@napolab/gct-core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./calendar": "./src/calendar/index.ts",
    "./dayjs": "./src/dayjs/index.ts",
    "./errors": "./src/errors/index.ts",
    "./google-client": "./src/google-client/index.ts",
    "./oauth": "./src/oauth/index.ts",
    "./scopes": "./src/scopes/index.ts",
    "./services": "./src/services/index.ts",
    "./tasks": "./src/tasks/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./calendar": "./dist/calendar.js",
      "./dayjs": "./dist/dayjs.js",
      "./errors": "./dist/errors.js",
      "./google-client": "./dist/google-client.js",
      "./oauth": "./dist/oauth.js",
      "./scopes": "./dist/scopes.js",
      "./services": "./dist/services.js",
      "./tasks": "./dist/tasks.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --write . && oxlint --fix .",
    "lint": "oxfmt --check . && oxlint .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "neverthrow": "^8.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
