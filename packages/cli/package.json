{
  "name": "@napolab/gct-cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "gct": "./src/main.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "gct": "./dist/main.mjs"
    },
    "exports": {
      ".": "./dist/main.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "tsdown",
    "fmt": "oxfmt --write . && oxlint --fix .",
    "lint": "oxfmt --check . && oxlint .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --typecheck --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@napolab/gct-core": "workspace:*",
    "dayjs": "^1.11.23",
    "gunshi": "^0.37.3",
    "hono": "^4.13.19",
    "neverthrow": "^8.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
